{
  "text": {
    "family": {
      "display": { "$value": "{typography.font-family.display}", "$type": "fontFamily" },
      "base":    { "$value": "{typography.font-family.base}",    "$type": "fontFamily" },
      "mono":    { "$value": "{typography.font-family.mono}",    "$type": "fontFamily" }
    },
    "size": {
      "display":    { "$value": "{typography.font-size.80}", "$type": "dimension" },
      "display-sm": { "$value": "{typography.font-size.40}", "$type": "dimension" },
      "heading-xl": { "$value": "{typography.font-size.56}", "$type": "dimension" },
      "heading-lg": { "$value": "{typography.font-size.32}", "$type": "dimension" },
      "heading-md": { "$value": "{typography.font-size.24}", "$type": "dimension" },
      "body-lg":    { "$value": "{typography.font-size.24}", "$type": "dimension" },
      "body":       { "$value": "{typography.font-size.16}", "$type": "dimension" },
      "ui":         { "$value": "{typography.font-size.14}", "$type": "dimension" },
      "caption":    { "$value": "{typography.font-size.12}", "$type": "dimension" }
    },
    "weight": {
      "display":   { "$value": "{typography.font-weight.heavy}",   "$type": "fontWeight" },
      "heading":   { "$value": "{typography.font-weight.semi}",    "$type": "fontWeight" },
      "editorial": { "$value": "{typography.font-weight.regular}", "$type": "fontWeight" },
      "body":      { "$value": "{typography.font-weight.regular}", "$type": "fontWeight" },
      "emphasis":  { "$value": "{typography.font-weight.medium}",  "$type": "fontWeight" }
    },
    "leading": {
      "display":    { "$value": "{typography.line-height.88}", "$type": "dimension" },
      "display-sm": { "$value": "{typography.line-height.48}", "$type": "dimension" },
      "heading-xl": { "$value": "{typography.line-height.64}", "$type": "dimension" },
      "heading-lg": { "$value": "{typography.line-height.40}", "$type": "dimension" },
      "heading-md": { "$value": "{typography.line-height.32}", "$type": "dimension" },
      "body-lg":    { "$value": "{typography.line-height.32}", "$type": "dimension" },
      "body":       { "$value": "{typography.line-height.24}", "$type": "dimension" },
      "ui":         { "$value": "{typography.line-height.24}", "$type": "dimension" },
      "caption":    { "$value": "{typography.line-height.16}", "$type": "dimension" }
    },
    "tracking": {
      "default": { "$value": "{typography.letter-spacing.0}", "$type": "dimension" }
    }
  }
}
