{
  "motion": {
    "duration": {
      "ui":    { "$value": "{duration.fast}",  "$type": "duration" },
      "enter": { "$value": "{duration.base}",  "$type": "duration" },
      "sheet": { "$value": "{duration.sheet}", "$type": "duration" }
    },
    "easing": {
      "ui":    { "$value": "{easing.standard}",   "$type": "cubicBezier" },
      "enter": { "$value": "{easing.decelerate}", "$type": "cubicBezier" },
      "sheet": { "$value": "{easing.sheet}",      "$type": "cubicBezier" }
    }
  }
}
