{
  "stat": {
    "color": {
      "background": { "$value": "{surface.color.alt}",     "$type": "color" },
      "value":      { "$value": "{text.color.heading}",    "$type": "color" },
      "label":      { "$value": "{text.color.subtle}",     "$type": "color" },
      "divider":    { "$value": "{border.color.hairline}", "$type": "color" },
      "rule-lead":  { "$value": "{action.color.accent}",   "$type": "color" },
      "rule-trail": { "$value": "{surface.color.inverse}", "$type": "color" }
    },
    "size": {
      "rule": { "$value": "{spacing.8}", "$type": "dimension" }
    },
    "space": {
      "inset-y": { "$value": "{space.lg}", "$type": "dimension" }
    }
  }
}
