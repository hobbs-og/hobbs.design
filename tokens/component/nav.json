{
  "nav": {
    "color": {
      "background":     { "$value": "{surface.color.page}",  "$type": "color" },
      "link":           { "$value": "{text.color.default}",  "$type": "color" },
      "link-hover":     { "$value": "{text.color.heading}",  "$type": "color" },
      "link-current":   { "$value": "{text.color.heading}",  "$type": "color" },
      "logo":           { "$value": "{text.color.default}",  "$type": "color" },
      "logo-hover":     { "$value": "{action.color.accent}", "$type": "color" },
      "logo-highlight": { "$value": "{surface.color.highlight}", "$type": "color" },
      "bar":            { "$value": "{text.color.default}",  "$type": "color" },
      "panel":          { "$value": "{surface.color.page}",  "$type": "color" }
    },
    "size": {
      "toggle":     { "$value": "{control.size.toggle}",     "$type": "dimension" },
      "bar-inline": { "$value": "{control.size.toggle-bar}", "$type": "dimension" },
      "bar-gap":    { "$value": "{control.size.toggle-gap}", "$type": "dimension" },
      "bar-stroke": { "$value": "{border.width.hairline}",   "$type": "dimension" }
    },
    "space": {
      "inset-y":   { "$value": "{space.nav-y}", "$type": "dimension" },
      "inset-x":   { "$value": "{space.nav-x}", "$type": "dimension" },
      "link-gap":  { "$value": "{space.lg}",    "$type": "dimension" },
      "panel-gap": { "$value": "{space.lg}",    "$type": "dimension" }
    },
    "motion": {
      "duration":        { "$value": "{motion.duration.ui}",     "$type": "duration" },
      "easing":          { "$value": "{motion.easing.ui}",       "$type": "cubicBezier" },
      "toggle-duration": { "$value": "{motion.duration.toggle}", "$type": "duration" },
      "toggle-easing":   { "$value": "{motion.easing.ui}",       "$type": "cubicBezier" }
    }
  }
}
